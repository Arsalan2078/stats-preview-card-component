---
import css from "./InformationCard.module.scss";
---

<div class={css.container}>
  <div class={css.card}>
    <div class={css.imgHolder}>
      <img src="/images/image-header-desktop.jpg" alt="" />
    </div>

    <div class={css.content}>
      <div>
        <h2>Get <span>insights</span> that help your business grow.</h2>

        <p>
          Discover the benefits of data analytics and make better decisions
          regarding revenue, customer experience, and overall efficiency.
        </p>
      </div>

      <ul>
        <li><span>10k+</span> <span>companies</span></li>
        <li><span>314</span> <span>templates</span></li>
        <li><span>12m+</span> <span>queries</span></li>
      </ul>
    </div>
  </div>
</div>
